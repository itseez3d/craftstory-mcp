{
  "name": "@craftstory/mcp",
  "version": "0.3.1",
  "mcpName": "io.github.itseez3d/craftstory-mcp",
  "description": "MCP server for the CraftStory API: talking-avatar videos from a photo (CraftStory 2.0) and short clips with generated sound (MiniMax H3), from Claude, Cursor and other MCP clients.",
  "type": "module",
  "bin": {
    "craftstory-mcp": "dist/index.js",
    "craftstory-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js dist/http.js",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "tsx test/smoke.ts",
    "prepack": "npm run build",
    "start:http": "node dist/http.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "craftstory",
    "ai-video",
    "talking-avatar",
    "lip-sync",
    "text-to-video",
    "minimax"
  ],
  "license": "MIT",
  "homepage": "https://github.com/itseez3d/craftstory-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/express": "^5.0.0"
  },
  "bugs": {
    "url": "https://github.com/itseez3d/craftstory-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itseez3d/craftstory-mcp.git"
  }
}
